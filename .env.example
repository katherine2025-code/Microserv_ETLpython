# Copia este archivo como .env y completa los valores. NUNCA subas el .env a git.

# --- Base de datos (la misma que usa el backend) ---
# Host de la BD. En local con Docker: 127.0.0.1
DB_HOST=127.0.0.1
# Puerto de la BD (3306 por defecto)
DB_PORT=3306
# Usuario con permisos sobre la base DB_NAME
DB_USER=ots_user
# Contraseña de ese usuario
DB_PASSWORD=cambia_esta_contrasena
# Nombre de la base de datos
DB_NAME=ots

# --- CORS - opcional ---
# Orígenes extra permitidos, separados por coma (los localhost:3000/8100/8101 ya están incluidos).
# Solo hace falta si el front o el backend corren en otro origen.
CORS_ORIGINS=

# --- Autenticación entre servicios ---
# OBLIGATORIO: token compartido con el backend. Toda petición (salvo /health) debe traer el
# header X-Service-Token con este valor; sin él, el servicio rechaza todo. Debe ser IGUAL al
# SERVICE_TOKEN del backend. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_TOKEN=pega_aqui_el_mismo_token_que_en_el_backend
